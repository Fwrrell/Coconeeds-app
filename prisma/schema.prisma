// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PETANI
  PERUSAHAAN
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  phoneNumber   String?   @unique
  pin           String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(PETANI)
  kopdesId      String?
  kopdes        Kopdes?   @relation(fields: [kopdesId], references: [id])
  ecoPoints     Int       @default(0)
  isVerified    Boolean   @default(false)

  approvalStatus ApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  panens      Panen[]
  wtbListings WtbListing[]

  lahan              Lahan[]             @relation("PetaniLahan")
  dailyLogs          DailyLog[]          @relation("PetaniDailyLog")
  financialTxs       FarmerFinancialTx[] @relation("PetaniFinancialTx")
  ecoPointTxs        EcoPointTx[]        @relation("PetaniEcoPointTx")
  inventory          FarmerInventory[]   @relation("PetaniInventory")
  inventoryMutations InventoryMutation[] @relation("PetaniInventoryMutation")
  wallet             Wallet?
}

enum WalletTxType {
  CREDIT
  DEBIT
}

model Wallet {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  balance      Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  transactions WalletTx[]
}

model WalletTx {
  id          String       @id @default(cuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  amount      Float
  type        WalletTxType
  description String?
  createdAt   DateTime     @default(now())
}

model AdminWhitelist {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kopdes {
  id        String   @id @default(uuid())
  name      String
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  panenList Panen[]
  batchList Batch[]
}

model SystemSetting {
  id                String   @id @default("global_config")
  autoVerifyNewUser Boolean  @default(false)
  juriAccess        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum PengirimanMethod {
  SELF_DELIVERY
  PICKUP
}

enum PanenStatus {
  PENDING_PICKUP
  PENDING_DROPOFF
  IN_WAREHOUSE
  IN_TRANSIT
  DELIVERED
  QC_IN_PROGRESS
}

model Panen {
  id               String           @id @default(uuid())
  petaniId         String
  petani           User             @relation(fields: [petaniId], references: [id], onDelete: Cascade)
  type             String // KOPRA | SABUT | TEMPURUNG
  expectedWeight   Float // estimasi berat (input petani)
  tanggalPanen     DateTime
  pengirimanMethod PengirimanMethod
  actualWeight     Float? // berat actual dari qc
  grade            String?
  moisture         Float?
  basePricePerKg   Float?
  profitMargin     Float?
  status           PanenStatus      @default(PENDING_PICKUP)

  trackingCode        String?   @unique
  driverName          String?
  qrCodePass          String? // data di dalam qr code
  handoverPin         String? // 6 digit pin
  handoverValidatedAt DateTime?
  pickupScheduledAt   DateTime? // tgl dijemput kopdes (tanpa jam)

  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id])
  kopdesId  String?
  kopdes    Kopdes?  @relation(fields: [kopdesId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id                String           @id @default(uuid())
  pengirimanKapalId String?
  pengirimanKapal   PengirimanKapal? @relation(fields: [pengirimanKapalId], references: [id])
  type              String
  totalWeight       Float
  status            PanenStatus      @default(IN_WAREHOUSE)
  wtbListingId      String?
  wtbListing        WtbListing?      @relation(fields: [wtbListingId], references: [id], onDelete: Cascade)
  kopdesId          String?
  kopdes            Kopdes?          @relation(fields: [kopdesId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  panens Panen[]
  ledger Ledger?
}

model Ledger {
  id          String   @id @default(ulid())
  batchId     String   @unique
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  prevHash    String // Hash dari batch sebelumnya
  currentHash String // Hash gabungan dari data batch + data qc
  createdAt   DateTime @default(now())
}

enum WtbStatus {
  OPEN
  DEAL
  COMPLETED
  CANCELLED
}

model WtbListing {
  id           String    @id @default(uuid())
  perusahaanId String
  perusahaan   User      @relation(fields: [perusahaanId], references: [id], onDelete: Cascade)
  komoditas    String // e.g.: KOPRA | SABUT | ...
  targetWeight Float
  maxPrice     Float
  destination  String
  status       WtbStatus @default(OPEN)
  dealPrice    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  negosiasi Negosiasi[]
  batches   Batch[]
}

model Negosiasi {
  id           String     @id @default(uuid())
  wtbId        String
  wtb          WtbListing @relation(fields: [wtbId], references: [id], onDelete: Cascade)
  senderRole   Role
  offeredPrice Float
  note         String?
  createdAt    DateTime   @default(now())
}

enum PengirimanKapalStatus {
  WAITING_DEPARTURE
  IN_TRANSIT
  ARRIVED
}

model Lahan {
  id                 String    @id @default(uuid())
  petaniId           String
  petani             User      @relation("PetaniLahan", fields: [petaniId], references: [id], onDelete: Cascade)
  namaLahan          String
  luasM2             Float
  jumlahPohon        Int
  lokasiAddress      String
  tanggalTanam       DateTime?
  pupuk              String?
  waktuPanenEstimate DateTime?
  status             String?   @default("PRODUKTIF")
  deskripsi          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyLogs DailyLog[]
}

enum WeatherCondition {
  CERAH
  BERAWAN
  HUJAN_RINGAN
  HUJAN_DERAS
  BADAI
}

model DailyLog {
  id               String           @id @default(uuid())
  lahanId          String
  lahan            Lahan            @relation(fields: [lahanId], references: [id], onDelete: Cascade)
  petaniId         String
  petani           User             @relation("PetaniDailyLog", fields: [petaniId], references: [id], onDelete: Cascade)
  tanggal          DateTime
  isWatered        Boolean          @default(false)
  harvestCountKg   Float?
  fruitDropCount   Int?
  pestType         String?
  weatherCondition WeatherCondition

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FarmerFinancialTxType {
  PEMASUKAN
  PENGELUARAN
}

model FarmerFinancialTx {
  id         String                @id @default(uuid())
  petaniId   String
  petani     User                  @relation("PetaniFinancialTx", fields: [petaniId], references: [id], onDelete: Cascade)
  tipe       FarmerFinancialTxType
  keterangan String
  nominalIdr Float
  kategori   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RewardCatalog {
  id          String  @id @default(uuid())
  title       String
  description String?
  costPoints  Int
  category    String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions EcoPointTx[]
}

enum EcoPointTxType {
  EARN
  REDEEM
}

model EcoPointTx {
  id          String         @id @default(uuid())
  petaniId    String
  petani      User           @relation("PetaniEcoPointTx", fields: [petaniId], references: [id], onDelete: Cascade)
  type        EcoPointTxType
  points      Int
  activity    String
  rewardId    String?
  reward      RewardCatalog? @relation(fields: [rewardId], references: [id])
  voucherCode String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InventoryCategory {
  PRODUK_PRIMER
  PRODUK_OLAHAN
  PRODUK_SAMPINGAN
}

model FarmerInventory {
  id          String            @id @default(uuid())
  petaniId    String
  petani      User              @relation("PetaniInventory", fields: [petaniId], references: [id], onDelete: Cascade)
  kategori    InventoryCategory
  jenisProduk String
  jumlah      Float
  satuan      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([petaniId, jenisProduk])
}

enum InventoryMutationType {
  MASUK
  KELUAR
}

enum InventoryMutationReason {
  HASIL_PANEN
  PRODUKSI_OLAHAN
  KONSUMSI_PRIBADI
  RUSAK_SUSUT
  PENJUALAN
}

model InventoryMutation {
  id         String                  @id @default(uuid())
  petaniId   String
  petani     User                    @relation("PetaniInventoryMutation", fields: [petaniId], references: [id], onDelete: Cascade)
  komoditas  String
  tipe       InventoryMutationType
  jumlah     Float
  satuan     String
  alasan     InventoryMutationReason
  keterangan String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PengirimanKapal {
  id          String                @id @default(uuid())
  namaKapal   String
  rute        String
  totalBiaya  Float
  totalWeight Float
  status      PengirimanKapalStatus @default(WAITING_DEPARTURE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  batches    Batch[]
  splitBills SplitBill[]
}

model SplitBill {
  id                String          @id @default(uuid())
  pengirimanKapalId String
  pengirimanKapal   PengirimanKapal @relation(fields: [pengirimanKapalId], references: [id], onDelete: Cascade)
  lokasiKopdes      String
  weight            Float
  amountToPay       Float
}
